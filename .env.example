# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required. Free key, no card: https://console.groq.com
GROQ_API_KEY=

# Optional fallback provider. Free key: https://aistudio.google.com
# If set, the LLM layer fails over to Gemini when Groq rate-limits.
GEMINI_API_KEY=

# Optional. Where escalation events are POSTed. Leave blank to log locally instead.
ESCALATION_WEBHOOK_URL=
